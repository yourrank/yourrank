{
  "name": "yourrank-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../packages/shared build && next dev",
    "build": "bun run --cwd ../../packages/shared build && next build",
    "build:worker": "bun run --cwd ../../packages/shared build && opennextjs-cloudflare build",
    "preview": "bun run --cwd ../../packages/shared build && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bun run --cwd ../../packages/shared build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:ci": "opennextjs-cloudflare deploy",
    "test": "bun test ./src/__tests__",
    "lint": "tsc --noEmit",
    "typecheck": "bun run --cwd ../../packages/shared build && tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@yourrank/shared": "workspace:*",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "latest",
    "@types/bun": "^1.3.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4",
    "wrangler": "4.106.0"
  }
}
