# Local dev: start Postgres with `docker compose up -d`, then set:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:5432/yourrank
#
# Supabase Postgres connection string (direct, not pooler). Used as a fallback
# when Hyperdrive is not bound.
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# NOWPayments API (optional, for crypto billing)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Resend for transactional email (optional)
RESEND_API_KEY=
MAIL_FROM=YourRank <hey@yourrank.site>

# Pro plan price in USD (optional, default 29)
PRO_PRICE_USD=29

# Lead webhook URL (optional, Discord/Slack)
LEAD_WEBHOOK_URL=

# Telegram webhook URL (optional, for bot integration notifications)
TELEGRAM_WEBHOOK_URL=

# Discord monitoring webhook (REQUIRED for production — cron failures are silent without this)
DISCORD_MONITORING_WEBHOOK=

# Session cookie domain (default: .yourrank.site)
SESSION_COOKIE_DOMAIN=.yourrank.site

# Legacy fallback cutoff dates (ISO 8601). Leave empty to keep fallbacks enabled.
# LEGACY_GM_SESSION_CUTOFF=2099-12-31T00:00:00Z
# LEGACY_PLAN_TIER_CUTOFF=2099-12-31T00:00:00Z

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Admin TOTP secret (base32, for 2FA)
ADMIN_TOTP_SECRET=

# Cloudflare Zone ID (for cache purge)
CF_ZONE_ID=

# TOKEN_ENC_KEY (32-byte hex, for token encryption at rest)
TOKEN_ENC_KEY=

# Kick webhook public key (PEM). Get it from https://api.kick.com/public/v1/public-key
# or from your Kick developer app settings.
KICK_WEBHOOK_PUBLIC_KEY=

# Kick OAuth app credentials.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Kick OAuth redirect URI. Must exactly match the URL in your Kick app settings.
# Viewer OAuth callbacks must use a verified HTTPS origin.
KICK_REDIRECT_URI=https://yourrank.site/auth/kick/callback
# Viewer provider switches: blank/omitted = auto (credentials + callback validation).
# Invalid values fail closed. Production Discord remains deliberately disabled
# until its dedicated app/account flow is re-verified.
VIEWER_KICK_OAUTH_ENABLED=
VIEWER_DISCORD_OAUTH_ENABLED=false

# Discord Viewer OAuth app credentials (never commit real values).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the exact request origin callback for the environment.
DISCORD_REDIRECT_URI=https://yourrank.site/api/viewer/auth/discord/callback

# One-click dashboard demo (leave ALLOW_DEMO_LOGIN empty/false in production)
ALLOW_DEMO_LOGIN=false
DEMO_USER_EMAIL=demo@yourrank.site

# Optional Google Business Profile review/photo URLs (/reviews page)
GBP_REVIEW_URL=
GBP_PHOTO_URL=
