# Local dev values — copy to .dev.vars and fill in secrets.
# These are read by `wrangler dev` (not committed).

# Hyperdrive local connection string. Start the container first:
#   docker compose up -d
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:postgres@localhost:5432/yourrank

# Fallback if Hyperdrive is removed or not bound:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yourrank

# Polar: fill locally; see docs/POLAR_BILLING_SETUP.md. Never commit real secrets.
POLAR_SERVER=sandbox
POLAR_ORGANIZATION_ID=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_ANNUAL=
POLAR_PRODUCT_TEAM_MONTHLY=
POLAR_PRODUCT_TEAM_ANNUAL=
PUBLIC_BASE_URL=http://localhost:8791

# Optional secrets (leave blank to disable the feature):
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RESEND_API_KEY=
MAIL_FROM=YourRank <hey@yourrank.site>
LEAD_WEBHOOK_URL=
DISCORD_MONITORING_WEBHOOK=
SENTRY_DSN=
TOKEN_ENC_KEY=
ADMIN_TOTP_SECRET=
CF_ZONE_ID=
PRO_PRICE_USD=29
SESSION_COOKIE_DOMAIN=.yourrank.site

# Kick webhook public key (PEM) for verifying channel-point redemption events.
KICK_WEBHOOK_PUBLIC_KEY=

# Kick OAuth app credentials.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Viewer OAuth requires a verified HTTPS origin and secure callback cookies.
# Default HTTP localhost cannot complete this flow; keep both providers disabled
# locally and use an isolated HTTPS staging deployment for end-to-end checks.
KICK_REDIRECT_URI=
VIEWER_KICK_OAUTH_ENABLED=false
VIEWER_DISCORD_OAUTH_ENABLED=false

# Discord Viewer OAuth app credentials (use a dedicated non-production app).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
