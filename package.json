{
  "name": "yourrank",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/leaderboard",
    "apps/bot",
    "apps/monitor",
    "apps/web",
    "packages/*",
    "e2e"
  ],
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.16",
    "@yourrank/shared": "workspace:*",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "postgres": "3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "toucan-js": "^4.1.1",
    "typescript": "5.5.4",
    "wrangler": "4.106.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "cd apps/leaderboard && bun run build",
    "build:bot": "cd apps/bot && bun run build",
    "e2e": "cd e2e && bun run test",
    "lint": "(cd apps/bot && bun run lint) && (cd apps/leaderboard && bun run lint) && bun run lint:consumer",
    "lint:consumer": "eslint apps/consumer/src --ext .js --no-eslintrc -c apps/leaderboard/.eslintrc.json",
    "build:brand-assets": "bun run --cwd packages/shared build && node scripts/build-brand-assets.mjs",
    "check:test-mocks": "node scripts/check-test-mocks.mjs",
    "typecheck": "(cd packages/shared && bun run build) && (cd apps/bot && bun run typecheck) && (cd apps/leaderboard && bun run typecheck:games) && (cd apps/monitor && bun run typecheck) && (cd apps/web && bun run typecheck) && tsc -p apps/consumer/tsconfig.json",
    "test": "bun run scripts/test.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "overrides": {
    "js-yaml": ">=4.3.1",
    "undici": "^7.29.0"
  }
}
