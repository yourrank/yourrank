exports[`shared public board renderer keeps the fixed fixture HTML stable 1`] = `
"<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Leaderboard · Ampersand &amp; Board</title><meta name="description" content="Leaderboard for Ampersand &amp; Board&#39;s public site." />
