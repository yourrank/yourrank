<meta name="twitter:card" content="summary" /><meta name="twitter:title" content="Ampersand &amp; Board" /><meta name="twitter:description" content="Leaderboard for Ampersand &amp; Board&#39;s public site." /><meta property="og:image" content="https://example.test/og.png" /><meta name="twitter:image" content="https://example.test/og.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" data-async />
<script nonce="fixed-nonce">document.querySelector('link[data-async]').onload=function(){this.media='all'};</script>
<noscript><link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
<link rel="stylesheet" href="/assets/site-shell.css" />
<link rel="stylesheet" href="/assets/viewer-shell.css" />

<style nonce="fixed-nonce" data-theme-tokens>.yr-site{--yr-accent:var(--yr-color-board-accent);--yr-accent-ink:#000000}</style>

</head><body class="yr-site viewer-shell" data-section="leaderboard" data-slug="board fixture" data-custom-domain="false" data-currency="$" data-rank-by="wagered">
<!--
THESIS: A viewer's community home.
OWN-WORLD: User-supplied viewer-dashboard.html: ice canvas, white center panel, quiet navigation, blue pills, circular guide and membership rail.
STORY: Select a community, browse its rewards, follow personal claims, return to your memberships.
FIRST VIEWPORT: 212px navigation, flexible center panel, 314px community overview beneath one context bar.
FORM: The supplied HTML is the visual specification. Production routes and scoped records supply all content and actions.
-->
<a class="yr-sr" href="#main-content">Skip to content</a>
<div class="viewer-layout"><header class="viewer-topbar"><a class="viewer-brand" href="/board%20fixture"><span><svg class="lb-brand-mark-svg" viewBox="30 30 516 640" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M530 48L529 46L524 42L518 42L516 43L513 46L510 47L508 49L501 53L497 57L483 66L480 69L460 82L446 93L436 99L432 103L428 105L425 108L414 115L403 124L389 133L381 140L371 146L360 155L349 162L345 166L338 170L334 174L324 180L320 184L313 188L299 199L292 203L289 206L288 206L274 216L271 216L269 214L265 212L252 202L242 196L238 192L235 191L232 188L228 186L221 180L211 174L204 168L198 165L195 162L191 160L181 152L178 151L168 143L165 142L162 139L161 139L158 136L147 129L144 126L131 118L127 114L126 114L121 110L118 109L111 103L92 91L89 88L79 82L76 79L73 78L59 68L52 68L50 69L46 74V191L47 192V195L50 201L54 205L63 210L66 213L79 221L82 224L85 225L87 227L91 229L98 235L126 253L129 256L132 257L134 259L141 263L144 266L160 276L163 279L166 280L169 283L172 284L175 287L176 287L178 289L191 297L194 300L201 304L204 307L211 311L216 316V318L218 322V365L221 369L223 369L224 370L228 370L229 369L231 369L233 367L240 363L247 357L270 342L277 336L306 317L309 314L319 308L322 305L335 297L339 293L355 283L365 275L371 272L374 269L385 262L389 258L392 257L394 255L398 253L401 250L402 250L408 245L418 239L421 236L431 230L435 226L442 222L452 214L453 214L455 212L465 206L468 203L472 201L475 198L482 194L485 191L496 184L503 178L506 177L512 172L522 166L527 161L530 154V48ZM450 266L446 264L441 264L435 267L432 270L426 273L417 280L402 289L395 295L392 296L383 303L380 304L371 311L370 311L365 315L362 316L359 319L353 322L350 325L340 331L337 334L325 341L322 344L303 356L300 359L291 364L287 368L284 369L282 371L275 375L272 378L271 378L263 384L260 385L254 390L244 396L241 399L240 399L235 403L232 404L221 414L218 420V505L221 509L223 510L228 510L232 508L234 506L274 480L277 477L280 476L282 474L289 470L292 467L298 464L304 459L305 459L316 451L319 450L321 448L328 444L331 441L332 441L343 433L346 432L364 419L367 418L370 415L383 407L389 402L392 401L394 399L401 395L404 392L420 382L423 379L433 373L439 368L445 365L448 362L451 357V355L453 351V272ZM388 449L380 449L378 451L375 452L369 457L337 478L334 481L331 482L329 484L322 488L319 491L316 492L314 494L304 500L301 503L291 509L288 512L276 519L273 522L257 532L248 539L245 540L238 546L235 547L233 549L226 553L223 556L223 557L219 562L219 564L218 565V652L220 655L222 656L225 656L226 657L227 656L231 655L244 645L247 644L249 642L262 634L265 631L287 617L291 613L294 612L296 610L303 606L306 603L322 593L325 590L335 584L338 581L351 573L358 567L359 567L364 563L367 562L374 556L377 555L379 553L383 551L389 545L393 536V455Z" fill="#2200ff" fill-rule="evenodd"/></svg></span><b>yourrank</b><small>Viewer</small></a><span class="viewer-top-title" id="viewer-top-title">Leaderboard</span><div class="viewer-top-actions"><a class="viewer-icon-button" href="/help/support?audience=viewer&amp;return=%2Fboard%2520fixture%2Fleaderboard" aria-label="Help and contact" title="Help and contact"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.7 9a2.4 2.4 0 1 1 4.2 1.5C13 11.2 12 11.5 12 13m0 3h.01"/></svg></a><details class="viewer-switch"><summary aria-label="Select community"><span class="viewer-avatar">A</span><span>Ampersand &amp; Board</span><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary><div class="viewer-switch-menu"><p>Your selected community</p><a href="/board%20fixture">Ampersand &amp; Board</a><a href="/me">Switch community <svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg></a></div></details><a class="viewer-user" id="viewer-top-avatar" href="/me#vd-profile" aria-label="Viewer account" title="Open viewer account"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>Account</span></a></div></header>
<aside class="viewer-rail" aria-label="Viewer navigation">
<div class="viewer-creator"><span class="viewer-avatar">A</span><div><span class="viewer-fine">Current community</span><strong>Ampersand &amp; Board</strong><span>Creator community</span></div></div>
<nav class="viewer-destinations" aria-label="Community pages"><a href="/board%20fixture"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 10 9-7 9 7v11h-7v-7H9v7H3Z"/></svg>Home</a><a href="/board%20fixture/leaderboard" aria-current="page"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3h8v7a4 4 0 0 1-8 0ZM8 5H4v3a4 4 0 0 0 4 4m8-7h4v3a4 4 0 0 1-4 4m-4 2v6m-4 1h8"/></svg>Leaderboard</a><a href="/board%20fixture/shop"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="5" rx="1.5"/><path d="M5 12v9h14v-9M12 7v14m0-14C7 8 4 3 7 2c3-1 5 5 5 5Zm0 0c5 1 8-4 5-5-3-1-5 5-5 5Z"/></svg>Reward shop</a><a href="/board%20fixture/me"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/><circle cx="20" cy="18" r="2"/></svg>My activity</a></nav>
<div class="viewer-rail-account"><p class="viewer-nav-caption">Your account</p><a class="yr-btn yr-btn--sm" href="/board%20fixture/me">Sign in</a><a id="viewer-communities-link" href="/me"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg>My communities</a><a id="viewer-account-link" href="/me#vd-profile" hidden><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>Viewer account</a></div>

<div class="viewer-sidebar-bottom"><a href="/help/support?audience=viewer&amp;return=%2Fboard%2520fixture%2Fleaderboard"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.7 9a2.4 2.4 0 1 1 4.2 1.5C13 11.2 12 11.5 12 13m0 3h.01"/></svg>Help &amp; contact</a><p><strong>Your people. Your place.</strong><br>Made for the other side of the stream.</p></div>

</aside>
<main class="viewer-main" id="main-content">
<header class="viewer-panel-head"><div class="viewer-community-heading"><span class="viewer-avatar viewer-avatar-large">A</span><div><p class="viewer-context-name" data-preview-field="f_name">Ampersand &amp; Board</p><p class="viewer-context-sub">Creator community</p></div></div><a class="yr-btn yr-btn--ghost" href="/board%20fixture/me#membership-code"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v5a2 2 0 0 0 0 4v5H4v-5a2 2 0 0 0 0-4Zm10 0v3m0 3v2m0 3v3"/></svg>Redeem code</a></header>
<section class="yr-lbh">
<h1 class="yr-h1 yr-lbh-title">Leaderboard</h1>
<p class="yr-lbh-meta"><span class="yr-lbh-state is-live">Live</span><span>Q&amp;A leaderboard</span></p>
<p class="yr-lbh-note">Ranked by wagered. Tied players share a rank.</p>
</section>
<div data-player-board>
<div class="yr-panel yr-lb">
<div class="yr-panel-head yr-panel-head--quiet"><h2 class="yr-sr">Standings</h2><span class="yr-panel-meta"><span data-player-count-badge>2 players</span></span></div>
<div class="yr-search-row"><label class="yr-sr" for="yr-search">Search players</label><input class="yr-search" id="yr-search" type="search" placeholder="Search players by name" autocomplete="off" enterkeyhint="search" /></div><div class="yr-stand-head" aria-hidden="true" data-hide-prizes="false"><span>#</span><span>Player</span><span class="yr-r">Wagered</span><span class="yr-r">Prize</span></div>
<ol class="yr-stand" data-rows aria-label="Standings for Ampersand &amp; Board" data-value-label="Wagered" data-prize-label="Prize" data-hide-prizes="false"><li class="yr-srow yr-srow--first" data-player-name="alice &lt;3" data-position="1">
<span class="yr-srow-rank"><span class="yr-sr">Rank </span>1</span>
<a class="yr-srow-name" href="/board%20fixture/player/Alice%20%3C3">Alice &lt;3</a>
<span class="yr-srow-val"><span class="yr-sr">Wagered: </span>$5,000</span>
<span class="yr-srow-prize"><span class="yr-sr">Prize: </span>$100</span>
</li><li class="yr-srow yr-srow--top" data-player-name="bob" data-position="2">
<span class="yr-srow-rank"><span class="yr-sr">Rank </span>2</span>
<a class="yr-srow-name" href="/board%20fixture/player/Bob">Bob</a>
<span class="yr-srow-val"><span class="yr-sr">Wagered: </span>$3,000</span>
<span class="yr-srow-prize"><span class="yr-sr">Prize: </span>$60</span>
</li></ol>
<p class="yr-nomatch" id="yr-no-match" hidden>No players match that search.</p>
<p class="yr-search-status" id="yr-search-status" role="status" aria-live="polite"></p>


</div></div>
<footer class="viewer-panel-footer"><span><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg>Your credits and claims stay with this community.</span><a href="/help/support?audience=viewer&amp;return=%2Fboard%2520fixture%2Fleaderboard">How YourRank works <svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></footer>
</main>
<aside class="viewer-overview" aria-label="Selected community overview"><section class="viewer-rail-panel viewer-credit-panel"><div class="viewer-rail-head"><h2>Your community credits</h2><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 4 16 4 16 0V6M4 12v6c0 4 16 4 16 0v-6"/></svg></div><p>Sign in to see your credits in this community.</p></section>

<section class="viewer-rail-panel"><div class="viewer-rail-head"><h3>On the leaderboard</h3><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3h8v7a4 4 0 0 1-8 0ZM8 5H4v3a4 4 0 0 0 4 4m8-7h4v3a4 4 0 0 1-4 4m-4 2v6m-4 1h8"/></svg></div><div class="viewer-board-list"><div class="viewer-board-row"><span class="viewer-rank">01</span><span class="viewer-avatar">AL</span><span class="viewer-player-name">Alice &lt;3</span><span>$5,000</span></div><div class="viewer-board-row"><span class="viewer-rank">02</span><span class="viewer-avatar">BO</span><span class="viewer-player-name">Bob</span><span>$3,000</span></div></div></section>
<div class="viewer-scope-help"><svg class="viewer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg><p><strong>Your membership, your history.</strong>Credits and claims are kept separate for every community you join.</p></div></aside></div><div class="viewer-site-footer"><footer class="yr-foot">
<p class="yr-fine">Credits are free loyalty points earned from channel-point rewards. No purchase, no cash value, no cashout.</p>
<div class="yr-foot-bar">
<p class="yr-foot-c">&copy; 2026 Ampersand &amp; Board.</p>
<div class="yr-foot-links">            <a href="https://example.test/board%20fixture/terms">Terms of Service</a>            <a href="https://example.test/board%20fixture/privacy">Privacy Policy</a>            <a href="https://example.test/board%20fixture/cookies">Cookie Policy</a>            <a href="https://example.test/board%20fixture/refund">Refund Policy</a>            <a href="https://example.test/board%20fixture/contact">Contact Us</a>            <a href="https://example.test/board%20fixture/responsible">Responsible Play</a><button type="button" data-feedback-open>Send feedback</button></div>
</div>
<nav class="yr-foot-links yr-foot-nav" aria-label="All sections"><a href="https://example.test/board%20fixture">Home</a><a href="https://example.test/board%20fixture/leaderboard">Leaderboard</a><a href="https://example.test/board%20fixture/shop">Reward shop</a><a href="https://example.test/board%20fixture/me">My activity</a></nav>
</footer></div>
<dialog id="yr-feedback" class="yr-modal" aria-labelledby="yr-feedback-title">
<form class="yr-modal-in" method="dialog">
<h2 id="yr-feedback-title">Send feedback</h2>
<p class="yr-note">Send a suggestion to this site's owner. There is no personal reply here. If you need a response, use the creator's contact channels.</p>
<textarea name="message" rows="5" minlength="10" maxlength="2000" placeholder="What's working? What's not?" required aria-label="Your feedback"></textarea>
<p class="yr-modal-status" id="yr-feedback-status" role="status" aria-live="polite"></p>
<div class="yr-modal-acts">
<button class="yr-btn yr-btn--ghost yr-btn--sm" type="button" id="yr-feedback-close">Cancel</button>
<button class="yr-btn yr-btn--sm" type="submit">Send</button>
</div>
<input type="hidden" name="slug" value="board fixture" />
</form>
</dialog>
<script src="/assets/cookie-consent.js" nonce="fixed-nonce" defer></script>
<script src="/assets/viewer-app.js" nonce="fixed-nonce" defer></script>
</body></html>"
`;
